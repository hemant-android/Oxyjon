<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/rlHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@color/white">

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_20sdp"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_regular_400"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="@dimen/_12sdp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:layout_centerInParent="true"
                android:src="@mipmap/logo" />

            <LinearLayout
                android:id="@+id/llPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="5dp"
                android:layout_toLeftOf="@+id/imgCallUs"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgPremium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <RelativeLayout
                    android:id="@+id/rlPremium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_premium"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/ic_king"
                        android:drawablePadding="5dp"
                        android:fontFamily="@font/roboto_medium_500"
                        android:padding="5dp"
                        android:text="Premium"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_8ssp"
                        android:visibility="visible" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/rlPremiumBlur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/imgInfo"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="-5dp"
                        android:background="@drawable/bg_premium_blur"
                        android:drawableLeft="@drawable/ic_king"
                        android:drawablePadding="5dp"
                        android:fontFamily="@font/roboto_medium_500"
                        android:padding="5dp"
                        android:text="Premium"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_8ssp"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/imgInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_info"
                        android:visibility="visible" />

                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgCallUs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_toLeftOf="@+id/imgNotification"
                android:src="@drawable/ic_call_us"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/imgNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/_20sdp"
                android:src="@drawable/ic_notofication" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF5709"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_medium_500"
            android:maxLines="1"
            android:padding="@dimen/_7sdp"
            android:textColor="#ffffff"
            android:textSize="@dimen/_10ssp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_dashboard"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llBottom"
        android:layout_below="@+id/llHeader"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <LinearLayout
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/llHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="#B6BCE5"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:lineSpacingExtra="4sp"
                android:text="Home"
                android:textColor="#37474F"
                android:textSize="@dimen/_10sdp"
                android:translationY="-1.8sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llDiary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_diary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:lineSpacingExtra="4sp"
                android:text="Diary"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/_10sdp"
                android:translationY="-1.8sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llPlan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_plan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:lineSpacingExtra="4sp"
                android:text="Plans"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/_10sdp"
                android:translationY="-1.8sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:lineSpacingExtra="4sp"
                android:text="Profile"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/_10sdp"
                android:translationY="-1.8sp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>