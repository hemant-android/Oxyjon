<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <RelativeLayout
        android:id="@+id/rlHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/white">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_back" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sdp"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:src="@mipmap/logo" />

        <ImageView
            android:id="@+id/imgMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/_20sdp"
            android:src="@drawable/ic_message"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_toLeftOf="@+id/imgMessage"
            android:src="@drawable/ic_notofication"
            android:visibility="gone" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rlRenewPlan"
        android:layout_below="@+id/rlHeader"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular_400"
                android:gravity="center"
                android:lineSpacingExtra="4sp"
                android:text="My Care Team"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/_18sdp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgB2BBanner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize5Percent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvEducatorTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium_500"
                    android:gravity="center"
                    android:lineSpacingExtra="5sp"
                    android:text="Educator"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/_12sdp"
                    android:visibility="gone" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:elevation="@dimen/_2sdp"
                    app:cardCornerRadius="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/llEducator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/_10sdp"
                            android:visibility="gone">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgEducator"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="@dimen/_60sdp"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/place_holder"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize5Percent" />

                            <TextView
                                android:id="@+id/tvEducatorCallLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentRight="true"
                                android:fontFamily="@font/roboto_medium_500"
                                android:lineSpacingExtra="4sp"
                                android:text="1 Call left"
                                android:textColor="#60BA1A"
                                android:textSize="@dimen/_8ssp"
                                android:translationY="-0.97sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="@dimen/_5sdp"
                                android:layout_toRightOf="@+id/imgEducator"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvEducatorName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/roboto_regular_400"
                                    android:gravity="center"
                                    android:lineSpacingExtra="4sp"
                                    android:maxLines="1"
                                    android:textColor="#000000"
                                    android:textSize="@dimen/_16sdp"
                                    android:translationY="-1.8sp" />

                                <TextView
                                    android:id="@+id/tvEducatorDetail"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/roboto_regular_400"
                                    android:lineSpacingExtra="4sp"
                                    android:maxLines="2"
                                    android:textColor="#1E1E1E"
                                    android:textFontWeight="400"
                                    android:textSize="@dimen/_8sdp"
                                    android:translationY="-0.97sp" />

                                <TextView
                                    android:id="@+id/tvEducatorNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/roboto_regular_400"
                                    android:lineSpacingExtra="4sp"
                                    android:textColor="#1E1E1E"
                                    android:textFontWeight="400"
                                    android:textSize="@dimen/_12sdp"
                                    android:translationY="-0.97sp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgNoEducator"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_80sdp"
                            android:layout_gravity="center_vertical"
                            android:scaleType="fitXY"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize5Percent" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/llDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium_500"
                    android:gravity="center"
                    android:lineSpacingExtra="5sp"
                    android:text="Doctor"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/_12sdp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:elevation="@dimen/_2sdp"
                    app:cardCornerRadius="3dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_10sdp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgDoctor"
                            android:layout_width="@dimen/_60sdp"
                            android:layout_height="@dimen/_60sdp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/place_holder"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize5Percent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_toRightOf="@+id/imgDoctor"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDrName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_regular_400"
                                android:gravity="center"
                                android:lineSpacingExtra="4sp"
                                android:maxLines="1"
                                android:textColor="#000000"
                                android:textSize="@dimen/_16sdp"
                                android:translationY="-1.8sp" />

                            <TextView
                                android:id="@+id/tvDrSpecialist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_regular_400"
                                android:lineSpacingExtra="4sp"
                                android:maxLines="2"
                                android:textColor="#1E1E1E"
                                android:textFontWeight="400"
                                android:textSize="@dimen/_8sdp"
                                android:translationY="-0.97sp" />

                            <androidx.appcompat.widget.AppCompatRatingBar
                                android:id="@+id/ratingBar"
                                style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:numStars="5"
                                android:rating="0"
                                android:stepSize="0.5"
                                android:theme="@style/RatingBar" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDrCallLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentRight="true"
                            android:fontFamily="@font/roboto_medium_500"
                            android:lineSpacingExtra="4sp"
                            android:text="1 Call left"
                            android:textColor="#60BA1A"
                            android:textSize="@dimen/_8ssp"
                            android:translationY="-0.97sp"
                            android:visibility="gone" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llFamily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium_500"
                    android:gravity="center"
                    android:lineSpacingExtra="5sp"
                    android:text="Family Member"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/bg_white"
                    android:orientation="vertical"
                    android:padding="@dimen/_5sdp">

                    <LinearLayout
                        android:id="@+id/llName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5sdp"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".4"
                            android:fontFamily="@font/roboto_medium_500"
                            android:lineSpacingExtra="4sp"
                            android:text="Name"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_12sdp"
                            android:translationY="-1.8sp" />

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_weight=".6"
                            android:fontFamily="@font/roboto_regular_400"
                            android:lineSpacingExtra="2sp"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_10sdp"
                            android:translationY="-0.97sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llRelationShip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5sdp"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".4"
                            android:fontFamily="@font/roboto_medium_500"
                            android:lineSpacingExtra="4sp"
                            android:text="Relationship"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_12sdp"
                            android:translationY="-1.8sp" />

                        <TextView
                            android:id="@+id/tvRelation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_weight=".6"
                            android:fontFamily="@font/roboto_regular_400"
                            android:lineSpacingExtra="2sp"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_10sdp"
                            android:translationY="-0.97sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5sdp"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".4"
                            android:fontFamily="@font/roboto_medium_500"
                            android:lineSpacingExtra="4sp"
                            android:text="Mobile Number"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_12sdp"
                            android:translationY="-1.8sp" />

                        <TextView
                            android:id="@+id/tvMobileNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_weight=".6"
                            android:fontFamily="@font/roboto_regular_400"
                            android:lineSpacingExtra="2sp"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_10sdp"
                            android:translationY="-0.97sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5sdp"
                        android:visibility="gone"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".4"
                            android:fontFamily="@font/roboto_medium_500"
                            android:lineSpacingExtra="4sp"
                            android:text="Note"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_12sdp"
                            android:translationY="-1.8sp" />

                        <TextView
                            android:id="@+id/tvNote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_weight=".6"
                            android:fontFamily="@font/roboto_regular_400"
                            android:lineSpacingExtra="2sp"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/_10sdp"
                            android:translationY="-0.97sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAddFamilyMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_plus_circle"
                android:drawablePadding="@dimen/_10sdp"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center_vertical"
                android:lineSpacingExtra="5sp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:text="Add Family Member"
                android:textColor="#FF5709"
                android:textSize="@dimen/_12sdp"
                android:visibility="visible" />
        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/rlRenewPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFEEE6"
        android:padding="@dimen/_15sdp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_toLeftOf="@+id/tvRenew"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:lineSpacingExtra="4sp"
                android:text="Plan Renewal Notification"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular_400"
                android:lineSpacingExtra="4sp"
                android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit,"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRenew"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_orange"
            android:fontFamily="@font/roboto_regular_400"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="Renew"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:translationY="-2.62sp"
            android:visibility="visible" />
    </RelativeLayout>
</RelativeLayout>